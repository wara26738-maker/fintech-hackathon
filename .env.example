# ─────────────────────────────────────────
# Banking AI Agent — Environment Variables
# ─────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file to ".env"
#        cp .env.example .env
#   2. Fill in your real values in ".env"
#   3. NEVER commit the ".env" file
# ─────────────────────────────────────────

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────
APP_NAME=BankingAIAgent
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
LOG_LEVEL=INFO

# ─────────────────────────────────────────
# LLM Provider (OpenAI / Anthropic / etc.)
# ─────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=2000

# For Anthropic (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/banking_agent
DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking_agent
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ─────────────────────────────────────────
# Vector Store (for RAG)
# ─────────────────────────────────────────
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENV=your_pinecone_env_here

# ─────────────────────────────────────────
# Security
# ─────────────────────────────────────────
SECRET_KEY=your_super_secret_key_change_me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Multi-Factor Authentication
MFA_ENABLED=true
MFA_ISSUER=BankingAIAgent

# Session
SESSION_TIMEOUT=1800

# ─────────────────────────────────────────
# Permission Tiers (RMB)
# ─────────────────────────────────────────
GREEN_TIER_AUTO=true
YELLOW_TIER_MAX_AMOUNT=1000
RED_TIER_MIN_AMOUNT=1000
SAFETY_LOCK_MAX_FAILURES=5

# ─────────────────────────────────────────
# Sandbox Execution
# ─────────────────────────────────────────
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT=10
SANDBOX_MAX_MEMORY_MB=256
SANDBOX_ALLOW_NETWORK=false

# ─────────────────────────────────────────
# Audit & Logging
# ─────────────────────────────────────────
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=./logs/audit.log
AUDIT_LOG_RETENTION_DAYS=90

# ─────────────────────────────────────────
# Banking Mock API (for demo)
# ─────────────────────────────────────────
BANK_API_BASE_URL=https://api.example-bank.com/v1
BANK_API_KEY=your_bank_api_key_here

# ─────────────────────────────────────────
# Demo Mode (run without real API keys)
# ─────────────────────────────────────────
USE_MOCK=true

# ─────────────────────────────────────────
# Notification (for renewal reminders)
# ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
NOTIFICATION_FROM=noreply@bankingagent.com


# ─────────────────────────────────────────
# DeepSeek LLM Provider (for RAG)
DEEPSEEK_API_KEY=sk-a60d1b02548c43bda731b1919af8046d
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_PROVIDER=deepseek